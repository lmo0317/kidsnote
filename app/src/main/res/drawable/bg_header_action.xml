<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="#28414C" />
      <stroke android:width="1dp" android:color="#58707A" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#142630" />
      <stroke android:width="1dp" android:color="#3B535E" />
      <corners android:radius="18dp" />
    </shape>
  </item>
</selector>
